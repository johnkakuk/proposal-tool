{
  // Bridger Digital Proposals Worker: REST API, MCP server, OAuth, tracking ingest, cron (SPEC §2).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bridger-proposals-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // No routes and no workers.dev URL: the Worker is reachable only through the Pages
  // project's `API` service binding (apps/web/functions/_middleware.ts), which forwards
  // /api, /mcp, /oauth, /.well-known, and /t. That keeps the domain's DNS wherever it is.
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "APP_URL": "https://proposals.bridgerdigital.com",
    "OWNER_EMAIL": "john@bridgerdigital.com",
    "EMAIL_FROM": "Bridger Digital <proposals@bridgerdigital.com>",
    "EMAIL_TRANSPORT": "resend"
  },

  // Production ids (from `wrangler kv namespace create OAUTH_KV` / `RATE_KV`).
  // RATE_KV now only holds signed-PDF retry counts; rate limiting uses `ratelimits` below.
  // Local dev (`wrangler dev`) simulates KV and ignores these ids.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "272409bdd7794aafb37385082be6d644" },
    { "binding": "RATE_KV", "id": "cf5f52cdce1543b2877bb6e471000c2e" }
  ],

  // Workers Rate Limiting (src/lib/rateLimit.ts): no KV writes, available on the Free plan.
  // Period must be 10 or 60 s. namespace_id is any integer unique within the account.
  "ratelimits": [
    // OTP send/verify, sign, decline, extension requests, tracking session start. Keyed per IP.
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // Tracking event batches, per IP (a tab sends 4/min).
    { "name": "RL_TRACK_EVENTS", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
  ],

  // Browser Rendering for PDFs (SPEC §12). Free plan: 10 min/day, 3 concurrent browsers,
  // 1 new browser / 20 s. Failures are retried by the hourly cron.
  "browser": { "binding": "BROWSER" },

  "triggers": {
    // Cron runs in UTC. 10:00 UTC ≈ 03:00 Pacific. The digest job runs inside the hourly
    // trigger and checks the owner's local time (SPEC §13).
    "crons": ["0 * * * *", "0 10 * * *"]
  },

  "observability": { "enabled": true }
}
