{
  "name": "bridger-proposals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bridger/api --filter @bridger/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "gen:seed": "tsx scripts/gen-seed-templates.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:integration": "pnpm --filter @bridger/api test:integration"
  },
  "devDependencies": {
    "@bridger/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "supabase": "^2.117.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
