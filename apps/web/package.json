{
  "name": "@bridger/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json",
    "pages:dev": "vite build && wrangler pages dev dist --port 8788",
